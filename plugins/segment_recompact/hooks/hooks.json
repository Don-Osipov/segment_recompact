{
  "hooks": {
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}\" && cargo build --release && mkdir -p bin && rm -f bin/recompact && cp target/release/recompact bin/recompact && chmod +x bin/recompact"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook session-start || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$RECOMPACT_SHELL\" ] && [ -x \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook user-prompt-submit || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook stop || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$RECOMPACT_SHELL\" ] && [ -x \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook post-tool-use || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
