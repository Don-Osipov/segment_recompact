{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook session-start 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook user-prompt-submit 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook stop 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$RECOMPACT_SHELL$CLAUDE_JOB_DIR\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook post-tool-use 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$RECOMPACT_SHELL$CLAUDE_JOB_DIR\" ] || [ \"${CLAUDE_CODE_ENTRYPOINT#claude-desktop}\" != \"$CLAUDE_CODE_ENTRYPOINT\" ] || exit 0; \"${CLAUDE_PLUGIN_ROOT}/bin/recompact\" hook pre-compact; [ $? -eq 2 ] && exit 2; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
